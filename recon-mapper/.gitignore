.pytype/
.pyre/

# ── Databases / pipeline output ───────────────────────────────────────────────
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ── Reports (generated output — add to VCS only if explicitly tracking) ───────
reports/*.json
reports/*.html
reports/*.md

# ── Secrets & credentials ─────────────────────────────────────────────────────
.env
*.env
.env.*
secrets.yaml
secrets.json
api_keys.txt
*.pem
*.key
*.crt
*.p12
*.pfx

